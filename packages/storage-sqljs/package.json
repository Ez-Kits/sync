    "fake-indexeddb": "catalog:",
    "sql.js": "catalog:",
    "typescript": "catalog:",
    "vite-plus": "catalog:"
  },
  "peerDependencies": {
    "@ez-kits/sync-client-core": "workspace:^",
    "sql.js": "catalog:"
  }
