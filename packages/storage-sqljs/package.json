{
  "$schema": "https://json.schemastore.org/package",
  "name": "@ez-kits/sync-storage-sqljs",
  "version": "0.0.0",
  "description": "SQLite storage for EzSync in the browser, saved to IndexedDB",
  "homepage": "https://github.com/Ez-Kits/sync/tree/main/packages/storage-sqljs#readme",
  "bugs": {
    "url": "https://github.com/Ez-Kits/sync/issues"
  },
  "license": "MIT",
  "author": "Ez Kits",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Ez-Kits/sync.git",
    "directory": "packages/storage-sqljs"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "exports": {
    ".": "./dist/index.mjs",
    "./worker": "./dist/worker.mjs",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
