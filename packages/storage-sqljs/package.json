{
  "$schema": "https://json.schemastore.org/package",
  "name": "@ez-kits/sync-storage-sqljs",
  "version": "0.0.0",
  "description": "sql.js DB storage for EzSync: SQLite (sql.js) in a leader worker, persisted to IndexedDB",
  "license": "MIT",
  "files": [
    "dist"
  ],
  "type": "module",
  "exports": {
    ".": "./dist/index.mjs",
    "./worker": "./dist/worker.mjs",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "vp pack",
    "dev": "vp pack --watch",
    "test": "vp test",
    "test:types": "vp test run --typecheck.only",
    "test:coverage": "vp test run --coverage",
    "check": "vp check",
    "prepublishOnly": "vp run build"
  },
  "devDependencies": {
    "@ez-kits/sync-client-core": "workspace:*",
    "@types/node": "^25.5.0",
    "@types/sql.js": "catalog:",
    "@typescript/native-preview": "catalog:",
    "fake-indexeddb": "catalog:",
    "sql.js": "catalog:",
    "typescript": "catalog:",
    "vite-plus": "catalog:"
  },
  "peerDependencies": {
    "@ez-kits/sync-client-core": "workspace:*",
    "sql.js": "catalog:"
  }
}
