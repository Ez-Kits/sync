{
  "name": "@ez-kits/sync-client-react",
  "version": "0.1.1",
  "description": "React integration for EzSync with live queries",
  "homepage": "https://github.com/Ez-Kits/sync/tree/main/packages/client-react#readme",
  "bugs": {
