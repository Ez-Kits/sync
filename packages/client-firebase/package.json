{
  "name": "@ez-kits/sync-client-firebase",
  "version": "0.0.0",
  "description": "Sync EzSync data with Cloud Firestore or Firebase Realtime Database",
  "homepage": "https://github.com/Ez-Kits/sync/tree/main/packages/client-firebase#readme",
  "bugs": {
    "url": "https://github.com/Ez-Kits/sync/issues"
  },
  "license": "MIT",
  "author": "Ez Kits",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Ez-Kits/sync.git",
    "directory": "packages/client-firebase"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "exports": {
    "./sync-firestore": "./dist/sync-firestore.mjs",
    "./sync-realtime-db": "./dist/sync-realtime-db.mjs",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "vp pack",
    "dev": "vp pack --watch",
    "test": "vp test",
    "test:types": "vp test run --typecheck.only",
    "test:coverage": "vp test run --coverage",
    "test:emulator": "firebase emulators:exec --config ../../firebase.json --project demo-ezsync --only auth,firestore,database 'EZSYNC_FIREBASE_EMULATOR=1 vp test run tests/emulator.integration.test.ts'",
    "check": "vp check",
    "prepublishOnly": "vp run build && node ../../scripts/copy-package-files.mjs"
  },
  "devDependencies": {
    "@types/node": "^25.5.0",
    "@typescript/native-preview": "catalog:",
    "firebase": "catalog:",
    "firebase-tools": "catalog:",
    "typescript": "catalog:",
    "vite-plus": "catalog:"
  },
  "peerDependencies": {
    "@ez-kits/sync-client-core": "workspace:^",
    "firebase": "^12.12.1"
  }
}
