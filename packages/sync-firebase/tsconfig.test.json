{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    "declaration": false,
    "emitDeclarationOnly": false,
    // Tests are resolved by Vite, so check them with bundler resolution.
    "module": "preserve",
    "moduleResolution": "bundler"
  },
  "include": ["src", "tests"]
}
