{
  "name": "@ez-kits/sync-client-drizzle-adapter",
  "version": "0.1.0",
  "description": "Use Drizzle ORM with EzSync",
  "homepage": "https://github.com/Ez-Kits/sync/tree/main/packages/client-drizzle#readme",
  "bugs": {
    "url": "https://github.com/Ez-Kits/sync/issues"
  },
  "license": "MIT",
  "author": "Ez Kits",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Ez-Kits/sync.git",
    "directory": "packages/client-drizzle"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./dist/index.mjs",
    "./pg": "./dist/pg.mjs",
    "./sqlite": "./dist/sqlite.mjs",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "vp pack",
    "dev": "vp pack --watch",
    "test": "vp test",
    "test:types": "vp test run --typecheck.only",
    "test:coverage": "vp test run --coverage",
    "check": "vp check",
    "prepublishOnly": "vp run build && node ../../scripts/copy-package-files.mjs"
  },
  "devDependencies": {
    "@electric-sql/pglite": "catalog:",
    "@ez-kits/sync-client-core": "workspace:*",
    "@ez-kits/sync-client-storage-pglite": "workspace:*",
    "@ez-kits/sync-client-storage-sqljs": "workspace:*",
    "@types/node": "^25.5.0",
    "@typescript/native-preview": "catalog:",
    "drizzle-orm": "catalog:",
    "sql.js": "catalog:",
    "typescript": "catalog:",
    "vite-plus": "catalog:"
  },
  "peerDependencies": {
    "@ez-kits/sync-client-core": "workspace:^",
    "drizzle-orm": "catalog:"
  }
}
