{
  "$schema": "https://json.schemastore.org/package",
  "name": "@ez-kits/sync-conflict-resolution",
  "version": "0.0.0",
  "description": "Built-in conflict resolution policies for EzSync",
  "license": "MIT",
  "files": [
    "dist"
  ],
  "type": "module",
  "exports": {
    ".": "./dist/index.mjs",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "vp pack",
    "dev": "vp pack --watch",
    "test": "vp test",
    "test:types": "vp test run --typecheck.only",
    "test:coverage": "vp test run --coverage",
    "check": "vp check",
    "prepublishOnly": "vp run build"
  },
  "devDependencies": {
    "@ez-kits/sync-client-core": "workspace:*",
    "@types/node": "^25.5.0",
    "@typescript/native-preview": "catalog:",
    "typescript": "catalog:",
    "vite-plus": "catalog:"
  },
  "peerDependencies": {
    "@ez-kits/sync-client-core": "workspace:*"
  }
}
