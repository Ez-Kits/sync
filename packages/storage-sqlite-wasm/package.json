{
  "$schema": "https://json.schemastore.org/package",
  "name": "@ez-kits/sync-storage-sqlite-wasm",
  "version": "0.0.0",
  "description": "SQLite WASM DB storage for EzSync: official SQLite build in a leader worker, persisted to OPFS",
  "license": "MIT",
  "files": [
    "dist"
  ],
  "type": "module",
  "exports": {
    ".": "./dist/index.mjs",
    "./worker": "./dist/worker.mjs",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "vp pack",
    "dev": "vp pack --watch",
    "test": "vp test",
    "test:types": "vp test run --typecheck.only",
    "test:coverage": "vp test run --coverage",
    "check": "vp check",
    "prepublishOnly": "vp run build"
  },
  "devDependencies": {
    "@ez-kits/sync-client-core": "workspace:*",
    "@sqlite.org/sqlite-wasm": "catalog:",
    "@types/node": "^25.5.0",
    "@typescript/native-preview": "catalog:",
    "typescript": "catalog:",
    "vite-plus": "catalog:"
  },
  "peerDependencies": {
    "@ez-kits/sync-client-core": "workspace:*",
    "@sqlite.org/sqlite-wasm": "catalog:"
  }
}
