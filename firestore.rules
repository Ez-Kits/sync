rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
    // A document written before revisions were turned on counts as revision 0.
    function revisionFollows() {
      return request.resource.data.rev
        == (resource == null ? 0 : resource.data.get('rev', 0)) + 1;
    }

    // Revisioned collections of the emulator tests: two signed-in devices share each collection.
    match /revisioned/{runId}/{collectionId}/{documentId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && revisionFollows();
    }
  }
}
